.page{min-height:100vh;padding:40rpx 28rpx;background:linear-gradient(#daf6ff,#68bfd4);color:#07304c}.title{font-size:64rpx;font-weight:700}.sub{margin:20rpx 0 30rpx}.board{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}.slot{height:300rpx;border:6rpx solid #6bc3d6;border-radius:28rpx;display:flex;flex-direction:column;justify-content:flex-end;padding:12rpx;gap:8rpx;background:#ffffff66}.slot.selected{border-color:#ffb84d}.token{height:52rpx;background:#fff;border-radius:16rpx;text-align:center;font-size:40rpx}.hint{text-align:center;margin-top:30rpx}
